+VKAPI_ATTR VkResult VKAPI_CALL boundedAllocateMemory(VkDevice device, const VkMemoryAllocateInfo* info, const VkAllocationCallbacks* allocator, VkDeviceMemory* memory) {
+    const auto bounded = boundedDevice(device);
