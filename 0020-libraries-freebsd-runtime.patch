+std::optional<BoundedDevice> boundedDevice(VkDevice device) {
+    auto& state = boundedDevices();
+    std::lock_guard lock(state.mutex);
+    const auto found = state.devices.find(device);
+    if (found == state.devices.end()) return std::nullopt;
+    return found->second;
+}
