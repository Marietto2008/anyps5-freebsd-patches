+    // (mmap(2)), which callers expect as EEXIST; with these otherwise valid arguments EINVAL can only mean
+    // "in use" or "outside the user address space", and both make the chunk unusable, like EEXIST.
+    static int ReserveNoReplace(std::uintptr_t address, std::size_t bytes) {
+        void* const wanted = reinterpret_cast<void*>(address);
+        void* const placed = mmap(wanted, bytes, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_EXCL, -1, 0);
+        if (placed == wanted) return 0;
+        if (placed == MAP_FAILED) return errno == EINVAL ? EEXIST : errno;
